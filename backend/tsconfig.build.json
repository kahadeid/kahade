{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // PRODUCTION BUILD CONFIG - Relaxed TypeScript checks for faster builds
    // This allows production build while code is being improved gradually
    
    // CRITICAL: Skip type checking for node_modules
    // This fixes the 8000+ errors from @types packages
    "skipLibCheck": true,
    
    "strict": false,
    "strictNullChecks": false,
    "noImplicitAny": false,
    "strictBindCallApply": false,
    "strictFunctionTypes": false,
    "strictPropertyInitialization": false,
    "noImplicitThis": false,
    "alwaysStrict": false,
    
    // RELAXED FOR PRODUCTION BUILD
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitReturns": false,
    "noFallthroughCasesInSwitch": false,
    "forceConsistentCasingInFileNames": true,
    "noUncheckedIndexedAccess": false,
    "noPropertyAccessFromIndexSignature": false,
    "exactOptionalPropertyTypes": false,
    "noImplicitOverride": false
  },
  "exclude": ["node_modules", "dist", "test", "**/*spec.ts"]
}
