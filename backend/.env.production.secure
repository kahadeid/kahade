# ============================================================================
# KAHADE BACKEND - PRODUCTION CONFIGURATION
# ============================================================================
# ⚠️ CRITICAL SECURITY NOTICE:
# 1. All secrets below have been auto-generated with cryptographically secure values
# 2. YOU MUST still configure external service credentials (marked with [REQUIRED])
# 3. NEVER commit this file to version control
# 4. Store securely and backup separately
# ============================================================================

# APPLICATION
NODE_ENV=production
PORT=3000
API_PREFIX=api
APP_NAME=Kahade
APP_URL=https://kahade.id
API_URL=https://api.kahade.id
ENABLE_SWAGGER=false

# DATABASE
# ⚠️ [REQUIRED] Update the password and database name for your production database
DATABASE_URL="postgresql://kahade_user:mc7f3B8g8Ws4MYpdTYb3oiV7H2FccAO@localhost:5432/kahade_prod?schema=public&connection_limit=20&pool_timeout=30"
DATABASE_POOL_MIN=5
DATABASE_POOL_MAX=20
DATABASE_SSL=true

# REDIS
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=oyCf7FI98HOv7xmPQco0beyleFwFEQ7S
REDIS_DB=0
REDIS_TLS=true
REDIS_KEY_PREFIX=kahade:prod:

# JWT & AUTHENTICATION
# ✅ Auto-generated secure secrets (64 chars each)
JWT_SECRET=59mC7g4dX8IlvtUYJU3QPvgzByvoYC0EUSvoRTaXLVlYajxfIP3NvEAYB8BRzMt2
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=He7dAUWiqN9F5g4EAPd9MhnFAzD9SXxqgUJOcpButvIzUvOj0diHnbWG3CoVDGm
JWT_REFRESH_EXPIRES_IN=7d

# BCRYPT
BCRYPT_ROUNDS=12

# SESSION
# ✅ Auto-generated secure secrets
SESSION_SECRET=YLfZ8QLt5pOiLljpMKHOCdiy3OwWKIdbqYUckJRTilavxGzscwPohI44TvoZZzw
SESSION_MAX_AGE=86400000
COOKIE_SECRET=30YgNOf5QnpyDzFNZwMT46d7mG3wdodA6UDSJI9HDCED5TwD06KxFjItwJX3pij

# CORS
# ⚠️ [REQUIRED] Update with your actual production domains
CORS_ORIGIN=https://kahade.id,https://www.kahade.id,https://app.kahade.id
CORS_CREDENTIALS=true

# RATE LIMITING
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100
RATE_LIMIT_STRICT=true

# FILE UPLOAD
MAX_FILE_SIZE=10485760
UPLOAD_PATH=/var/www/kahade/uploads
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp,application/pdf
ENABLE_FILE_SCAN=true

# EMAIL (SMTP)
# ⚠️ [REQUIRED] Configure your email service credentials
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@kahade.id
SMTP_PASS=[REQUIRED_YOUR_SMTP_PASSWORD_OR_APP_SPECIFIC_PASSWORD]
EMAIL_FROM=noreply@kahade.id
EMAIL_FROM_NAME=Kahade

# SMS
# ⚠️ [REQUIRED] Configure your SMS provider (Twilio example)
SMS_PROVIDER=twilio
SMS_API_KEY=[REQUIRED_YOUR_TWILIO_ACCOUNT_SID]
SMS_API_SECRET=[REQUIRED_YOUR_TWILIO_AUTH_TOKEN]
SMS_FROM=+6281234567890

# PAYMENT GATEWAY
# ⚠️ [REQUIRED] Configure your payment gateway (Xendit example)
PAYMENT_GATEWAY=xendit
PAYMENT_API_KEY=[REQUIRED_YOUR_XENDIT_PRODUCTION_API_KEY]
PAYMENT_WEBHOOK_SECRET=[REQUIRED_YOUR_XENDIT_WEBHOOK_SECRET]
PAYMENT_SANDBOX=false
PAYMENT_CALLBACK_URL=https://api.kahade.id/api/v1/webhooks/payment

# KYC PROVIDER
# ⚠️ [REQUIRED] Configure your KYC provider (Sumsub example)
KYC_PROVIDER=sumsub
KYC_API_KEY=[REQUIRED_YOUR_SUMSUB_PRODUCTION_API_KEY]
KYC_API_SECRET=[REQUIRED_YOUR_SUMSUB_PRODUCTION_API_SECRET]
KYC_WEBHOOK_SECRET=[REQUIRED_YOUR_SUMSUB_WEBHOOK_SECRET]
KYC_CALLBACK_URL=https://api.kahade.id/api/v1/webhooks/kyc

# ANTIVIRUS (ClamAV)
CLAMAV_ENABLED=true
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
CLAMAV_TIMEOUT=60000

# MONITORING & LOGGING
# ⚠️ [OPTIONAL] Configure Sentry for error tracking
SENTRY_DSN=[OPTIONAL_YOUR_SENTRY_DSN]
SENTRY_ENVIRONMENT=production
ENABLE_METRICS=true
METRICS_PORT=9090
PROMETHEUS_ENABLED=true

# LOGGING
LOG_LEVEL=info
LOG_FORMAT=json
LOG_DIR=/var/log/kahade
LOG_MAX_FILES=30
LOG_MAX_SIZE=100m

# BUSINESS RULES
PLATFORM_FEE_PERCENTAGE=2.5
MIN_TRANSACTION_AMOUNT=10000
MAX_TRANSACTION_AMOUNT=100000000
ESCROW_AUTO_RELEASE_DAYS=7
DISPUTE_DEADLINE_DAYS=3
KYC_EXPIRY_DAYS=365
KYC_REQUIRED_AMOUNT=5000000

# FEATURE FLAGS
ENABLE_REFERRAL=true
ENABLE_PROMO=true
ENABLE_BADGE=true
ENABLE_MFA=true
ENABLE_EMAIL_VERIFICATION=true
ENABLE_SMS_VERIFICATION=true
ENABLE_PUSH_NOTIFICATIONS=true

# BACKUP
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_PATH=/var/backups/kahade
BACKUP_S3_ENABLED=false
BACKUP_S3_BUCKET=kahade-backups
BACKUP_S3_REGION=ap-southeast-1

# QUEUE (Bull/Redis)
QUEUE_REDIS_HOST=localhost
QUEUE_REDIS_PORT=6379
QUEUE_REDIS_PASSWORD=oyCf7FI98HOv7xmPQco0beyleFwFEQ7S
QUEUE_REDIS_DB=1

# WEBHOOK
WEBHOOK_RETRY_ATTEMPTS=3
WEBHOOK_RETRY_DELAY=5000
WEBHOOK_TIMEOUT=30000

# SECURITY
# ✅ Auto-generated secure secrets
CSRF_SECRET=UO0x3eguFeFRRR806PfpaHU06hNkMmmesqGqW0CpSMTMScqMkCA96gqMKySAPe3
ENCRYPTION_KEY=dbd109de823af78dde3fd9df3ce4d2b9
ENCRYPTION_ALGORITHM=aes-256-gcm
ENABLE_HELMET=true
ENABLE_CSRF=true
TRUST_PROXY=true

# ADMIN
# ⚠️ [CRITICAL] Change this password immediately after first login!
ADMIN_EMAIL=admin@kahade.id
ADMIN_PASSWORD=9rYuesfcVcS35zoAQGkAJuHMROE

# SSL/TLS
# ⚠️ [REQUIRED] Update paths after setting up Let's Encrypt
SSL_CERT_PATH=/etc/letsencrypt/live/api.kahade.id/fullchain.pem
SSL_KEY_PATH=/etc/letsencrypt/live/api.kahade.id/privkey.pem

# CLOUDFLARE (Optional)
CLOUDFLARE_ENABLED=false
CLOUDFLARE_ZONE_ID=[OPTIONAL_YOUR_CLOUDFLARE_ZONE_ID]
CLOUDFLARE_API_KEY=[OPTIONAL_YOUR_CLOUDFLARE_API_KEY]

# SCALING
PM2_INSTANCES=max
PM2_EXEC_MODE=cluster
GRACEFUL_SHUTDOWN_TIMEOUT=30000

# HEALTH CHECK
HEALTH_CHECK_PATH=/api/v1/health
HEALTH_CHECK_INTERVAL=30

# EXTERNAL SERVICES
# ⚠️ [OPTIONAL] Configure if using cloud storage
GOOGLE_MAPS_API_KEY=[OPTIONAL_YOUR_GOOGLE_MAPS_KEY]
STORAGE_TYPE=local
AWS_S3_BUCKET=kahade-uploads
AWS_S3_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=[OPTIONAL_YOUR_AWS_ACCESS_KEY]
AWS_SECRET_ACCESS_KEY=[OPTIONAL_YOUR_AWS_SECRET_KEY]

# ============================================================================
