{
  "dashboard": {
    "title": "Kahade API Monitoring",
    "tags": ["kahade", "api", "monitoring"],
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "HTTP Request Rate",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(http_request_total[5m])",
            "legendFormat": "{{method}} {{route}}"
          }
        ]
      },
      {
        "id": 2,
        "title": "Response Time P95",
        "type": "graph",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket[5m]))",
            "legendFormat": "P95"
          },
          {
            "expr": "histogram_quantile(0.99, rate(http_request_duration_seconds_bucket[5m]))",
            "legendFormat": "P99"
          }
        ]
      },
      {
        "id": 3,
        "title": "Error Rate",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(http_errors_total[5m])",
            "legendFormat": "{{status}}"
          }
        ]
      },
      {
        "id": 4,
        "title": "Database Query Duration",
        "type": "graph",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(db_query_duration_seconds_bucket[5m]))",
            "legendFormat": "{{operation}} {{table}}"
          }
        ]
      },
      {
        "id": 5,
        "title": "Cache Hit Rate",
        "type": "stat",
        "targets": [
          {
            "expr": "rate(cache_hits_total[5m]) / (rate(cache_hits_total[5m]) + rate(cache_misses_total[5m]))",
            "legendFormat": "Hit Rate"
          }
        ]
      },
      {
        "id": 6,
        "title": "Active Users",
        "type": "stat",
        "targets": [
          {
            "expr": "active_users",
            "legendFormat": "Users"
          }
        ]
      },
      {
        "id": 7,
        "title": "Memory Usage",
        "type": "graph",
        "targets": [
          {
            "expr": "process_memory_usage_bytes{type='heap_used'}",
            "legendFormat": "Heap Used"
          },
          {
            "expr": "process_memory_usage_bytes{type='rss'}",
            "legendFormat": "RSS"
          }
        ]
      },
      {
        "id": 8,
        "title": "Business Metrics - Escrows",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(escrow_created_total[1h])",
            "legendFormat": "{{status}}"
          }
        ]
      },
      {
        "id": 9,
        "title": "Transaction Volume",
        "type": "graph",
        "targets": [
          {
            "expr": "histogram_quantile(0.50, rate(transaction_amount_bucket[1h]))",
            "legendFormat": "Median Amount"
          }
        ]
      },
      {
        "id": 10,
        "title": "Total Wallet Balance",
        "type": "stat",
        "targets": [
          {
            "expr": "wallet_balance_total",
            "legendFormat": "Total Balance"
          }
        ]
      }
    ],
    "templating": {
      "list": [
        {
          "name": "env",
          "type": "query",
          "query": "label_values(http_request_total, env)"
        }
      ]
    },
    "time": {
      "from": "now-6h",
      "to": "now"
    },
    "refresh": "30s"
  }
}
