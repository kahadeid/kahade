{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // ======================================================================
    // PRODUCTION BUILD OPTIMIZATIONS
    // ======================================================================
    // This config prioritizes successful builds for production deployment
    // Type safety is relaxed to allow gradual code improvements
    
    // SKIP TYPE CHECKING FOR NODE_MODULES
    // This is the KEY fix for 8078 errors - skips checking @types packages
    "skipLibCheck": true,
    
    // BUILD PERFORMANCE
    "incremental": true,
    "tsBuildInfoFile": ".tsbuildinfo",
    
    // RELAXED STRICT CHECKS
    "strict": false,
    "strictNullChecks": false,
    "noImplicitAny": false,
    "strictBindCallApply": false,
    "strictFunctionTypes": false,
    "strictPropertyInitialization": false,
    "noImplicitThis": false,
    "alwaysStrict": false,
    
    // RELAXED ADDITIONAL CHECKS
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitReturns": false,
    "noFallthroughCasesInSwitch": false,
    "noUncheckedIndexedAccess": false,
    "noPropertyAccessFromIndexSignature": false,
    "exactOptionalPropertyTypes": false,
    "noImplicitOverride": false,
    
    // KEEP CRITICAL PRODUCTION SAFETY
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    
    // SOURCE MAPS FOR DEBUGGING
    "sourceMap": true,
    "inlineSourceMap": false,
    
    // REMOVE COMMENTS FOR SMALLER BUNDLE
    "removeComments": true
  },
  "include": [
    "src/**/*",
    "prisma/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "test",
    "**/*spec.ts",
    "**/*test.ts",
    "**/__tests__/**",
    "**/__mocks__/**",
    "coverage",
    ".vscode",
    ".git"
  ]
}
