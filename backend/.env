NODE_ENV=development
PORT=3001
APP_NAME=Kahade
APP_URL=http://localhost:5000
API_URL=http://localhost:3001
FRONTEND_URL=http://localhost:5000
API_PREFIX=api
ENABLE_SWAGGER=true

# DATABASE_URL is provided by Replit environment
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false

JWT_SECRET=dev-jwt-secret-key-change-this-in-production-32chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=dev-jwt-refresh-secret-key-change-prod-32chars
JWT_REFRESH_EXPIRES_IN=7d

BCRYPT_ROUNDS=12

SESSION_SECRET=dev-session-secret-key-change-in-production-32chars
SESSION_MAX_AGE=86400000

COOKIE_SECRET=dev-cookie-secret-key-change-in-prod-32chars

CORS_ORIGIN=http://localhost:5000,https://5e46663d-5cd7-49e1-8182-d22dd996dc59-00-13vfuuawoudaa.pike.replit.dev
CORS_CREDENTIALS=true

RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

MAX_FILE_SIZE=5242880
UPLOAD_PATH=./uploads
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp,application/pdf

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@kahade.com

SMS_PROVIDER=twilio
SMS_API_KEY=
SMS_API_SECRET=
SMS_FROM=+1234567890

PAYMENT_GATEWAY=xendit
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=
PAYMENT_SANDBOX=true

KYC_PROVIDER=sumsub
KYC_API_KEY=
KYC_API_SECRET=
KYC_WEBHOOK_SECRET=

CLAMAV_ENABLED=false
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

SENTRY_DSN=
SENTRY_ENVIRONMENT=development
ENABLE_METRICS=false
METRICS_PORT=9090

PLATFORM_FEE_PERCENTAGE=2.5
MIN_TRANSACTION_AMOUNT=10000
MAX_TRANSACTION_AMOUNT=100000000
ESCROW_AUTO_RELEASE_DAYS=7
DISPUTE_DEADLINE_DAYS=3
KYC_EXPIRY_DAYS=365

ENABLE_REFERRAL=true
ENABLE_PROMO=true
ENABLE_BADGE=true
ENABLE_MFA=true
ENABLE_EMAIL_VERIFICATION=false
ENABLE_SMS_VERIFICATION=false

LOG_LEVEL=debug
LOG_FORMAT=json
LOG_DIR=./logs

BACKUP_ENABLED=false
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_PATH=./backups

QUEUE_REDIS_HOST=localhost
QUEUE_REDIS_PORT=6379
QUEUE_REDIS_DB=1

WEBHOOK_RETRY_ATTEMPTS=3
WEBHOOK_RETRY_DELAY=5000
WEBHOOK_TIMEOUT=30000

CSRF_SECRET=dev-csrf-secret-key-change-this
ENCRYPTION_KEY=dev-encryption-key-32-characters!
ENCRYPTION_IV=dev-iv-16-chars!!
ENCRYPTION_ALGORITHM=aes-256-gcm

ADMIN_EMAIL=admin@kahade.com
ADMIN_PASSWORD=change-this-password-immediately
