// ============================================================================
// FRAUD DETECTION SYSTEM
// Risk assessment and fraud prevention
// ============================================================================

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum FraudAlertStatus {
  PENDING
  INVESTIGATING
  CONFIRMED_FRAUD
  FALSE_POSITIVE
  RESOLVED
}

enum FraudRuleType {
  VELOCITY // Transaction frequency limits
  AMOUNT // Amount-based rules
  PATTERN // Behavioral patterns
  DEVICE // Device fingerprinting
  LOCATION // Geo-based rules
  ACCOUNT // Account-based rules
  NETWORK // Network/relationship rules
}

model FraudRule {
  id          String        @id @default(uuid())
  code        String        @unique
  name        String
  description String        @db.Text
  type        FraudRuleType

  // Rule configuration (JSON for flexibility)
  conditions Json // Rule conditions
  actions    Json // Actions when triggered

  // Scoring
  riskScore Int @default(10) @map("risk_score") // Points added to risk score

  // Settings
  isActive Boolean @default(true) @map("is_active")
  priority Int     @default(100) // Lower = higher priority

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  alerts FraudAlert[]

  @@index([type, isActive])
  @@index([priority])
  @@map("fraud_rules")
}

model UserRiskProfile {
  id     String @id @default(uuid())
  userId String @unique @map("user_id")

  // Risk scores
  overallRiskScore     Int @default(0) @map("overall_risk_score")
  transactionRiskScore Int @default(0) @map("transaction_risk_score")
  behaviorRiskScore    Int @default(0) @map("behavior_risk_score")

  // Risk level (calculated from scores)
  riskLevel RiskLevel @default(LOW) @map("risk_level")

  // Flags
  isWatchlisted   Boolean   @default(false) @map("is_watchlisted")
  watchlistReason String?   @map("watchlist_reason") @db.Text
  watchlistedAt   DateTime? @map("watchlisted_at") @db.Timestamptz
  watchlistedBy   String?   @map("watchlisted_by")

  // Restrictions
  requiresManualReview  Boolean @default(false) @map("requires_manual_review")
  maxTransactionAmount  BigInt? @map("max_transaction_amount") @db.BigInt
  dailyTransactionLimit BigInt? @map("daily_transaction_limit") @db.BigInt

  // Device & Location tracking
  knownDevices    Json?   @map("known_devices")
  knownLocations  Json?   @map("known_locations")
  lastKnownIp     String? @map("last_known_ip")
  lastKnownDevice String? @map("last_known_device")

  // Stats
  totalAlerts     Int @default(0) @map("total_alerts")
  confirmedFrauds Int @default(0) @map("confirmed_frauds")

  // Timestamps
  lastAssessedAt DateTime? @map("last_assessed_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  @@index([riskLevel])
  @@index([isWatchlisted])
  @@map("user_risk_profiles")
}

model FraudAlert {
  id String @id @default(uuid())

  // Subject
  userId        String? @map("user_id")
  orderId       String? @map("order_id")
  transactionId String? @map("transaction_id")

  // Alert details
  ruleId    String?   @map("rule_id")
  alertType String    @map("alert_type")
  riskLevel RiskLevel @map("risk_level")
  riskScore Int       @map("risk_score")

  // Description
  title       String
  description String @db.Text
  evidence    Json? // Supporting evidence

  // Status
  status FraudAlertStatus @default(PENDING)

  // Resolution
  resolvedAt  DateTime? @map("resolved_at") @db.Timestamptz
  resolvedBy  String?   @map("resolved_by")
  resolution  String?   @db.Text
  actionTaken String?   @map("action_taken") @db.Text

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  rule FraudRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([status, riskLevel])
  @@index([createdAt])
  @@map("fraud_alerts")
}

model TransactionRiskAssessment {
  id      String @id @default(uuid())
  orderId String @unique @map("order_id")

  // Risk assessment
  riskScore Int       @map("risk_score")
  riskLevel RiskLevel @map("risk_level")

  // Risk factors (detailed breakdown)
  riskFactors Json @map("risk_factors")

  // Flags triggered
  flagsTriggered Json? @map("flags_triggered")

  // Decision
  isApproved     Boolean   @default(true) @map("is_approved")
  requiresReview Boolean   @default(false) @map("requires_review")
  reviewedAt     DateTime? @map("reviewed_at") @db.Timestamptz
  reviewedBy     String?   @map("reviewed_by")
  reviewNotes    String?   @map("review_notes") @db.Text

  // Timestamps
  assessedAt DateTime @default(now()) @map("assessed_at") @db.Timestamptz

  @@index([riskLevel])
  @@index([requiresReview])
  @@map("transaction_risk_assessments")
}

model DeviceFingerprint {
  id     String @id @default(uuid())
  userId String @map("user_id")

  // Device info
  fingerprint String  @unique
  deviceType  String? @map("device_type") // mobile, desktop, tablet
  browser     String?
  os          String?

  // Trust level
  isTrusted  Boolean @default(false) @map("is_trusted")
  trustScore Int     @default(0) @map("trust_score")

  // Usage stats
  firstSeenAt DateTime @default(now()) @map("first_seen_at") @db.Timestamptz
  lastSeenAt  DateTime @default(now()) @map("last_seen_at") @db.Timestamptz
  loginCount  Int      @default(1) @map("login_count")

  // Flags
  isBlocked     Boolean @default(false) @map("is_blocked")
  blockedReason String? @map("blocked_reason")

  @@index([userId, isTrusted])
  @@index([fingerprint])
  @@map("device_fingerprints")
}

model IpReputation {
  id        String @id @default(uuid())
  ipAddress String @unique @map("ip_address")

  // Reputation
  reputationScore Int       @default(50) @map("reputation_score") // 0-100
  riskLevel       RiskLevel @default(LOW) @map("risk_level")

  // Flags
  isVpn        Boolean @default(false) @map("is_vpn")
  isProxy      Boolean @default(false) @map("is_proxy")
  isTor        Boolean @default(false) @map("is_tor")
  isDatacenter Boolean @default(false) @map("is_datacenter")

  // Geo info
  country String?
  city    String?
  isp     String?

  // Stats
  totalLogins  Int @default(0) @map("total_logins")
  failedLogins Int @default(0) @map("failed_logins")
  fraudAlerts  Int @default(0) @map("fraud_alerts")

  // Blocking
  isBlocked     Boolean   @default(false) @map("is_blocked")
  blockedReason String?   @map("blocked_reason")
  blockedAt     DateTime? @map("blocked_at") @db.Timestamptz

  // Timestamps
  firstSeenAt DateTime @default(now()) @map("first_seen_at") @db.Timestamptz
  lastSeenAt  DateTime @default(now()) @map("last_seen_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@index([riskLevel])
  @@index([isBlocked])
  @@map("ip_reputations")
}
