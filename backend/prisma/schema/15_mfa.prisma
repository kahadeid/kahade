// ============================================================================
// MULTI-FACTOR AUTHENTICATION (MFA)
// Complete MFA implementation with multiple methods
// ============================================================================

enum MFAMethod {
  TOTP // Time-based One-Time Password (Authenticator app)
  SMS // SMS verification code
  EMAIL // Email verification code
  WEBAUTHN // WebAuthn/FIDO2 (hardware keys)
}

enum MFAStatus {
  DISABLED
  PENDING_SETUP
  ENABLED
}

model UserMFA {
  id     String @id @default(uuid())
  userId String @unique @map("user_id")

  // Overall MFA status
  status MFAStatus @default(DISABLED)

  // TOTP settings
  totpEnabled    Boolean   @default(false) @map("totp_enabled")
  totpSecret     String?   @map("totp_secret") // Encrypted
  totpVerifiedAt DateTime? @map("totp_verified_at") @db.Timestamptz

  // SMS settings
  smsEnabled    Boolean   @default(false) @map("sms_enabled")
  smsPhone      String?   @map("sms_phone")
  smsVerifiedAt DateTime? @map("sms_verified_at") @db.Timestamptz

  // Email settings (uses user's verified email)
  emailEnabled Boolean @default(false) @map("email_enabled")

  // Backup codes
  backupCodes            Json?     @map("backup_codes") // Array of hashed codes
  backupCodesUsed        Int       @default(0) @map("backup_codes_used")
  backupCodesGeneratedAt DateTime? @map("backup_codes_generated_at") @db.Timestamptz

  // Preferred method
  preferredMethod MFAMethod? @map("preferred_method")

  // Recovery
  recoveryEmail String? @map("recovery_email")
  recoveryPhone String? @map("recovery_phone")

  // Timestamps
  enabledAt  DateTime? @map("enabled_at") @db.Timestamptz
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  webauthnCredentials WebAuthnCredential[]
  mfaLogs             MFALog[]

  @@index([userId])
  @@map("user_mfa")
}

model WebAuthnCredential {
  id        String @id @default(uuid())
  userMfaId String @map("user_mfa_id")

  // Credential info
  credentialId String @unique @map("credential_id")
  publicKey    String @map("public_key") @db.Text
  counter      BigInt @default(0)

  // Device info
  deviceName String? @map("device_name")
  deviceType String? @map("device_type") // platform, cross-platform

  // Attestation
  aaguid          String?
  attestationType String? @map("attestation_type")

  // Status
  isActive   Boolean   @default(true) @map("is_active")
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz

  // Timestamps
  registeredAt DateTime @default(now()) @map("registered_at") @db.Timestamptz

  userMfa UserMFA @relation(fields: [userMfaId], references: [id], onDelete: Cascade)

  @@index([userMfaId])
  @@map("webauthn_credentials")
}

model MFAChallenge {
  id     String @id @default(uuid())
  userId String @map("user_id")

  // Challenge info
  method    MFAMethod
  challenge String // The challenge/code (hashed for OTP)

  // Delivery info (for SMS/Email)
  sentTo String?   @map("sent_to")
  sentAt DateTime? @map("sent_at") @db.Timestamptz

  // Status
  isUsed Boolean   @default(false) @map("is_used")
  usedAt DateTime? @map("used_at") @db.Timestamptz

  // Expiration
  expiresAt DateTime @map("expires_at") @db.Timestamptz

  // Attempt tracking
  attempts    Int @default(0)
  maxAttempts Int @default(3) @map("max_attempts")

  // Context
  ipAddress String? @map("ip_address")
  userAgent String? @map("user_agent")

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([userId, method, isUsed])
  @@index([expiresAt])
  @@map("mfa_challenges")
}

model MFALog {
  id        String @id @default(uuid())
  userMfaId String @map("user_mfa_id")

  // Event info
  action  String // SETUP, VERIFY, DISABLE, BACKUP_CODE_USED, etc.
  method  MFAMethod?
  success Boolean

  // Context
  ipAddress String? @map("ip_address")
  userAgent String? @map("user_agent")

  // Error info
  errorMessage String? @map("error_message")

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  userMfa UserMFA @relation(fields: [userMfaId], references: [id], onDelete: Cascade)

  @@index([userMfaId, createdAt])
  @@index([action, success])
  @@map("mfa_logs")
}

model TrustedDevice {
  id     String @id @default(uuid())
  userId String @map("user_id")

  // Device identification
  deviceToken       String  @unique @map("device_token")
  deviceFingerprint String? @map("device_fingerprint")

  // Device info
  deviceName String? @map("device_name")
  deviceType String? @map("device_type")
  browser    String?
  os         String?

  // Trust settings
  trustLevel   Int       @default(1) @map("trust_level") // 1-5
  skipMfaUntil DateTime? @map("skip_mfa_until") @db.Timestamptz

  // Usage tracking
  lastUsedAt    DateTime @default(now()) @map("last_used_at") @db.Timestamptz
  lastIpAddress String?  @map("last_ip_address")
  useCount      Int      @default(1) @map("use_count")

  // Status
  isActive      Boolean   @default(true) @map("is_active")
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz
  revokedReason String?   @map("revoked_reason")

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([userId, isActive])
  @@index([deviceToken])
  @@map("trusted_devices")
}
