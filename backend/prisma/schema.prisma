// ============================================================================
// SUPPORT TICKETING SYSTEM
// Customer support and issue tracking
// ============================================================================

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_CUSTOMER
  WAITING_INTERNAL
  ON_HOLD
  RESOLVED
  CLOSED
  REOPENED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
  CRITICAL
}

enum TicketCategory {
  GENERAL_INQUIRY
  ACCOUNT_ISSUE
  TRANSACTION_ISSUE
  PAYMENT_ISSUE
  WITHDRAWAL_ISSUE
  KYC_VERIFICATION
  DISPUTE_HELP
  SECURITY_CONCERN
  BUG_REPORT
  FEATURE_REQUEST
  REFUND_REQUEST
  OTHER
}

model SupportTicket {
  id           String @id @default(uuid())
  ticketNumber String @unique @map("ticket_number") // e.g., "TKT-2024-001234"

  // Requester
  userId String @map("user_id")

  // Ticket details
  subject     String
  description String         @db.Text
  category    TicketCategory
  priority    TicketPriority @default(MEDIUM)
  status      TicketStatus   @default(OPEN)

  // Related entities
  orderId      String? @map("order_id")
  disputeId    String? @map("dispute_id")
  withdrawalId String? @map("withdrawal_id")

  // Assignment
  assignedToId String?   @map("assigned_to_id")
  assignedAt   DateTime? @map("assigned_at") @db.Timestamptz

  // Team/Department
  department String? @default("SUPPORT")

  // Tags for categorization
  tags Json?

  // SLA tracking
  slaDeadline     DateTime? @map("sla_deadline") @db.Timestamptz
  slaBreach       Boolean   @default(false) @map("sla_breach")
  firstResponseAt DateTime? @map("first_response_at") @db.Timestamptz

  // Resolution
  resolvedAt DateTime? @map("resolved_at") @db.Timestamptz
  resolvedBy String?   @map("resolved_by")
  resolution String?   @db.Text

  // Customer satisfaction
  satisfactionRating   Int?    @map("satisfaction_rating") // 1-5
  satisfactionFeedback String? @map("satisfaction_feedback") @db.Text

  // Escalation
  isEscalated      Boolean   @default(false) @map("is_escalated")
  escalatedAt      DateTime? @map("escalated_at") @db.Timestamptz
  escalatedTo      String?   @map("escalated_to")
  escalationReason String?   @map("escalation_reason") @db.Text

  // Timestamps
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  closedAt  DateTime? @map("closed_at") @db.Timestamptz

  // Relations
  responses    TicketResponse[]
  attachments  TicketAttachment[]
  history      TicketHistory[]
  conversation Conversation?

  @@index([userId, status])
  @@index([status, priority])
  @@index([assignedToId, status])
  @@index([category, status])
  @@index([createdAt])
  @@index([slaDeadline, slaBreach])
  @@map("support_tickets")
}

model TicketResponse {
  id       String @id @default(uuid())
  ticketId String @map("ticket_id")

  // Responder
  userId  String  @map("user_id")
  isStaff Boolean @default(false) @map("is_staff")

  // Response content
  message String @db.Text

  // Internal note (not visible to customer)
  isInternal Boolean @default(false) @map("is_internal")

  // Timestamps
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  editedAt  DateTime? @map("edited_at") @db.Timestamptz

  // Relations
  ticket      SupportTicket      @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  attachments TicketAttachment[]

  @@index([ticketId, createdAt])
  @@index([userId])
  @@map("ticket_responses")
}

model TicketAttachment {
  id         String  @id @default(uuid())
  ticketId   String  @map("ticket_id")
  responseId String? @map("response_id")

  // File info
  fileName String @map("file_name")
  fileUrl  String @map("file_url")
  fileSize Int    @map("file_size") // bytes
  mimeType String @map("mime_type")

  // Uploader
  uploadedBy String   @map("uploaded_by")
  uploadedAt DateTime @default(now()) @map("uploaded_at") @db.Timestamptz

  // Relations
  ticket   SupportTicket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  response TicketResponse? @relation(fields: [responseId], references: [id], onDelete: SetNull)

  @@index([ticketId])
  @@index([responseId])
  @@map("ticket_attachments")
}

model TicketHistory {
  id       String @id @default(uuid())
  ticketId String @map("ticket_id")

  // Change info
  action        String // e.g., "STATUS_CHANGED", "ASSIGNED", "PRIORITY_CHANGED"
  previousValue String? @map("previous_value")
  newValue      String? @map("new_value")

  // Actor
  performedBy String   @map("performed_by")
  performedAt DateTime @default(now()) @map("performed_at") @db.Timestamptz

  // Additional notes
  notes String? @db.Text

  // Relations
  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, performedAt])
  @@map("ticket_history")
}

model CannedResponse {
  id String @id @default(uuid())

  // Response template
  title    String
  content  String          @db.Text
  category TicketCategory?

  // Usage
  shortcut   String? @unique // Quick access code
  isActive   Boolean @default(true) @map("is_active")
  usageCount Int     @default(0) @map("usage_count")

  // Creator
  createdBy String   @map("created_by")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@index([category, isActive])
  @@map("canned_responses")
}

model SupportAgent {
  id     String @id @default(uuid())
  userId String @unique @map("user_id")

  // Agent info
  displayName String @map("display_name")
  department  String @default("SUPPORT")

  // Availability
  isAvailable    Boolean @default(true) @map("is_available")
  maxTickets     Int     @default(10) @map("max_tickets") // Max concurrent tickets
  currentTickets Int     @default(0) @map("current_tickets")

  // Skills/Categories they can handle
  skills Json? // Array of TicketCategory

  // Stats
  totalResolved     Int      @default(0) @map("total_resolved")
  avgResponseTime   Int?     @map("avg_response_time") // minutes
  avgResolutionTime Int?     @map("avg_resolution_time") // minutes
  satisfactionScore Decimal? @map("satisfaction_score") @db.Decimal(3, 2)

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@index([isAvailable, currentTickets])
  @@index([department])
  @@map("support_agents")
}

// ============================================================================
// SCHEDULED JOBS & AUTOMATION
// ============================================================================

model ScheduledJob {
  id         String  @id @default(uuid())
  jobType    String  @map("job_type")
  entityType String? @map("entity_type")
  entityId   String? @map("entity_id")

  scheduledAt DateTime  @map("scheduled_at")
  executedAt  DateTime? @map("executed_at")

