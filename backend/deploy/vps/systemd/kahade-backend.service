[Unit]
Description=Kahade Backend API (PM2 managed)
After=network.target postgresql.service redis.service
Wants=postgresql.service redis.service

[Service]
Type=forking
User=deploy
Environment=PM2_HOME=/home/deploy/.pm2
PIDFile=/home/deploy/.pm2/pm2.pid
ExecStart=/usr/bin/pm2 start /var/www/kahade/source/backend/ecosystem.config.prod.js --env production
ExecReload=/usr/bin/pm2 reload all --update-env
ExecStop=/usr/bin/pm2 kill
Restart=on-failure
RestartSec=10s

[Install]
WantedBy=multi-user.target
